            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "enum": [
                "order.created",
                "order.quoted",
                "order.dispatched",
                "order.picked_up",
                "order.out_for_delivery",
                "order.delivered",
                "order.delivery_failed",
                "order.cancelled",
