{
  "paths": {
    "/api/driver/v1/auth/mock-sessions": {
      "post": {
        "operationId": "driverMockSession",
        "summary": "司机端开发环境模拟登录（示例）",
        "description": "仅开发环境，固定示例验证码，不调用真实短信或 Telegram；生产环境关闭时返回 404。令牌只能用于本端路径前缀。",
        "tags": [
          "driver"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "phone",
                  "code"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+?[0-9]{6,15}$"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "success": {
                  "summary": "成功示例",
                  "value": {
                    "phone": "+85510000001",
                    "code": "123456"
                  }
                },
                "wrongCode": {
                  "summary": "拒绝示例：验证码错误",
                  "value": {
                    "phone": "+85510000001",
                    "code": "000000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "签发 8 小时 Bearer 令牌",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mode",
                    "audience",
                    "tokenType",
                    "accessToken",
                    "expiresAt",
                    "companyId",
                    "principalId",
                    "permissions"
                  ],
                  "properties": {
                    "mode": {
                      "const": "mock-development"
                    },
                    "audience": {
                      "enum": [
                        "driver"
                      ]
                    },
                    "tokenType": {
                      "const": "Bearer"
                    },
                    "accessToken": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "companyId": {
                      "type": "string"
                    },
                    "principalId": {
                      "type": "string"
                    },
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                },
                "examples": {
                  "success": {
                    "value": {
                      "mode": "mock-development",
                      "audience": "driver",
                      "tokenType": "Bearer",
                      "accessToken": "<redacted-example>",
                      "expiresAt": "2026-11-12T00:00:00.000Z",
                      "companyId": "00000000-0000-0000-0000-000000000001",
                      "principalId": "00000000-0000-0000-0000-000000000002",
                      "permissions": [
                        "driver:tasks:read"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "description": "UNAUTHENTICATED：手机号或验证码不正确（不泄露手机号是否存在）",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "rejected": {
                    "summary": "拒绝示例",
                    "value": {
                      "error": {
                        "code": "UNAUTHENTICATED",
                        "message": "手机号或验证码不正确",
                        "messageKey": "errors.unauthenticated",
                        "retryable": false,
                        "requestId": "req-example-0001",
                        "fields": []
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "LOCAL_ONLY：仅允许本机请求",
