                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "rejected": {
                    "summary": "拒绝示例",
                    "value": {
                      "error": {
                        "code": "LOCAL_ONLY",
                        "message": "仅允许本机请求",
                        "messageKey": "errors.localOnly",
                        "retryable": false,
                        "requestId": "req-example-0001",
                        "fields": []
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "405": {
            "description": "METHOD_NOT_ALLOWED：只支持无查询串的 POST",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "$ref": "#/components/schemas/Id"
