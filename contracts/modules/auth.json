{
  "module": "auth",
  "paths": {
    "/api/driver/v1/auth/mock-sessions": {
      "post": {
        "operationId": "driverMockSession",
        "summary": "司机端开发环境模拟登录（示例）",
        "description": "仅开发环境，固定示例验证码，不调用真实短信或 Telegram；生产环境关闭时返回 404。令牌只能用于本端路径前缀。仅开发环境，生产 fail-closed 404。另外可能返回：403 LOCAL_ONLY（非本机请求）、405 METHOD_NOT_ALLOWED（只支持无查询串的 POST）、413 BODY_TOO_LARGE（请求体超过 2048 字节）、415 UNSUPPORTED_MEDIA_TYPE（只接受 application/json），均为 {error:{code,message,messageKey,retryable,requestId,fields}} 结构。",
        "tags": [
          "driver"
        ],
        "security": [],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128,
              "pattern": "^[!-~]{16,128}$"
            },
            "description": "本接口不强制（登录豁免，见 x-idempotency）；每次调用只签发一个新的本地令牌，不写业务数据。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "phone",
                  "code"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+?[0-9]{6,15}$"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              },
              "examples": {
                "success": {
                  "summary": "成功示例",
                  "value": {
                    "phone": "+85510000001",
                    "code": "123456"
                  }
                },
                "wrongCode": {
                  "summary": "拒绝示例：验证码错误",
                  "value": {
                    "phone": "+85510000001",
                    "code": "000000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "签发 8 小时 Bearer 令牌",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mode",
                    "audience",
                    "tokenType",
                    "accessToken",
                    "expiresAt",
                    "companyId",
                    "principalId",
                    "permissions"
                  ],
                  "properties": {
                    "mode": {
                      "const": "mock-development"
                    },
                    "audience": {
                      "enum": [
                        "driver"
                      ]
                    },
                    "tokenType": {
                      "const": "Bearer"
                    },
                    "accessToken": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "companyId": {
                      "type": "string"
                    },
                    "principalId": {
                      "type": "string"
                    },
                    "permissions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          }
        },
        "x-permissions": [
          "dev:mock-login"
        ],
        "x-stage": "R1",
        "x-implementation-status": "DEV_ONLY_LOCAL_NOT_DEPLOYED",
        "x-version-resource": "none (creates a local development session)",
        "x-owner": "OpsLead",
        "x-idempotency": "AUTH_SECRET_EXCEPTION",
        "x-baseline-tier": "A",
        "x-examples": {
          "success": {
            "status": 200,
            "body": {
              "mode": "mock-development",
              "audience": "driver",
              "tokenType": "Bearer",
              "accessToken": "<redacted-example>",
              "expiresAt": "2026-11-12T00:00:00.000Z",
              "companyId": "00000000-0000-0000-0000-000000000001",
              "principalId": "00000000-0000-0000-0000-000000000002",
              "permissions": [
                "driver:tasks:read"
              ]
            }
          },
          "rejected": {
            "status": 401,
            "body": {
              "error": {
                "code": "UNAUTHENTICATED",
                "message": "手机号或验证码不正确",
                "messageKey": "errors.unauthenticated",
                "retryable": false,
                "requestId": "req-example-0001",
                "fields": []
              }
            }
          }
        }
      }
    },
