            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "rejected": {
                    "summary": "拒绝示例",
                    "value": {
                      "error": {
                        "code": "UNSUPPORTED_MEDIA_TYPE",
                        "message": "请使用application/json",
                        "messageKey": "errors.unsupportedMediaType",
                        "retryable": false,
                        "requestId": "req-example-0001",
                        "fields": []
                      }
                    }
