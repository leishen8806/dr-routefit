  "components": {
    "schemas": {
      "InboxMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "titleKey",
          "read",
          "createdAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "titleKey": {
            "type": "string"
          },
          "bodyKey": {
            "type": "string"
          },
          "read": {
            "type": "boolean"
          },
          "createdAt": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      },
      "InboxMarkRead": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ids"
        ],
        "properties": {
          "ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Id"
            }
          }
        }
      },
      "InboxMarkReadResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "updated"
        ],
        "properties": {
          "updated": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
