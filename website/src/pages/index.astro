---
const title = 'DR RouteFit';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <script is:inline>
      let saved = null;
      try {
        saved = localStorage.getItem('routefit-language');
      } catch {}

      const supported = ['km', 'en', 'zh'];
      const candidates = navigator.languages?.length ? navigator.languages : [navigator.language];
      let language = supported.includes(saved) ? saved : 'en';
      if (!supported.includes(saved)) {
        for (const candidate of candidates) {
          const normalized = candidate?.toLowerCase();
          if (normalized?.startsWith('zh')) { language = 'zh'; break; }
          if (normalized?.startsWith('km')) { language = 'km'; break; }
          if (normalized?.startsWith('en')) { language = 'en'; break; }
        }
      }

      try {
        localStorage.setItem('routefit-language', language);
      } catch {}

      location.replace(`/${language}/${location.search}${location.hash}`);
    </script>
    <noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
  </head>
  <body>
    <noscript><p><a href="/km/">ខ្មែរ</a> · <a href="/en/">English</a> · <a href="/zh/">中文</a></p></noscript>
  </body>
</html>
