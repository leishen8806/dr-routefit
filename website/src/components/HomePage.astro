---
import type { SiteCopy, Language } from '../content/types';
interface Props { lang: Language; copy: SiteCopy }
const { lang, copy } = Astro.props;
const withLang = (href: string) => href.startsWith('/') ? `/${lang}${href}` : href;
---
<section class="hero section">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{copy.hero.eyebrow}</p>
      <h1>{copy.hero.title}</h1>
      <p class="lead">{copy.hero.body}</p>
      <div class="button-row">
        <a class="button" href={`/${lang}/contact/`}>{copy.hero.primary}</a>
        <a class="button button-secondary" href={`/${lang}/drivers/`}>{copy.hero.secondary}</a>
      </div>
      <p class="slogan">{copy.hero.note}</p>
    </div>
    <div class="route-visual" aria-label={copy.hero.route.join(', ')}>
      <div class="route-scene">
        <div class="route-track" aria-hidden="true"><span></span><span></span><span></span></div>
        {copy.hero.route.map((label, index) => (
          <div class:list={['route-step', `route-step-${index + 1}`]}>
            <span aria-hidden="true">{index === 1 ? 'RF' : index + 1}</span>
            <strong>{label}</strong>
          </div>
        ))}
        <p>{copy.hero.note}</p>
      </div>
    </div>
  </div>
</section>

<section class="quick-section section-tight">
  <div class="shell quick-grid">
    {copy.quick.map((item, index) => (
      <article id={item.badge ? 'track' : undefined} class:list={['quick-card', { muted: item.badge }]}>
        <div class="quick-number">0{index + 1}</div>
        <h2>{item.title}</h2><p>{item.body}</p>
        {item.badge ? <span class="badge">{item.badge}</span> : <a href={withLang(item.href)}>{item.action}<span aria-hidden="true"> →</span></a>}
      </article>
    ))}
  </div>
</section>

<section id="services" class="section values-section">
  <div class="shell">
    <div class="section-heading"><p class="eyebrow">{copy.values.eyebrow}</p><h2>{copy.values.title}</h2></div>
    <div class="value-grid">
      {copy.values.items.map((item) => <article><span>{item.icon}</span><h3>{item.title}</h3><p>{item.body}</p></article>)}
    </div>
  </div>
</section>

<section id="process" class="section process-section">
  <div class="shell">
    <div class="section-heading"><p class="eyebrow">{copy.process.eyebrow}</p><h2>{copy.process.title}</h2></div>
    <ol class="process-grid">
      {copy.process.items.map((item, index) => <li><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}
    </ol>
  </div>
</section>

<section class="section coverage-section">
  <div class="shell coverage-card">
    <div><p class="eyebrow">{copy.coverage.eyebrow}</p><h2>{copy.coverage.title}</h2><p>{copy.coverage.body}</p><a class="text-link" href={`/${lang}/contact/`}>{copy.coverage.action} →</a></div>
    <div class="coverage-map" aria-hidden="true"><span></span><span></span><span></span><strong>DR</strong></div>
  </div>
</section>

<section id="about" class="section audience-section">
  <div class="shell audience-grid">
    {copy.audiences.map((item, index) => <article class={index === 0 ? 'dark-card' : 'light-card'}><p class="eyebrow">{item.eyebrow}</p><h2>{item.title}</h2><p>{item.body}</p><a class={index === 0 ? 'button button-light' : 'button'} href={withLang(item.href)}>{item.action}</a></article>)}
  </div>
</section>

<section id="help" class="section faq-section">
  <div class="shell faq-grid">
    <div class="section-heading"><p class="eyebrow">{copy.faq.eyebrow}</p><h2>{copy.faq.title}</h2></div>
    <div class="faq-list">{copy.faq.items.map((item, index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div>
  </div>
</section>
