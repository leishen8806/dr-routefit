---
const screens = [
  { id: 'screen-1', label: '首屏' },
  { id: 'screen-2', label: '车对货' },
  { id: 'screen-3', label: '路对线' },
  { id: 'screen-4', label: '准时送到' },
  { id: 'screen-5', label: '每一步有记录' },
  { id: 'screen-6', label: '合作入口' }
];
---
<a class="fullpage-skip" href="#screen-1">跳到主要内容</a>

<header class="fullpage-topbar" aria-label="原型页导航">
  <a class="topbar-mark" href="/zh/" aria-label="DR RouteFit 中文首页">
    <img src="/logo.svg" alt="DR RouteFit" />
  </a>
  <nav class="topbar-actions" aria-label="语言与联系">
    <a class="topbar-language is-active" href="/zh/" lang="zh" aria-current="page" data-contrast-button>中文</a>
    <a class="topbar-language" href="/en/" lang="en" data-contrast-button>EN</a>
    <a class="topbar-language" href="/km/" lang="km" data-contrast-button>ខ្មែរ</a>
    <a class="topbar-contact" href="/zh/contact/" data-contrast-button>联系我们</a>
  </nav>
</header>

<main class="fullpage-preview" aria-label="DR RouteFit 一屏一版中文预览">
  <nav class="fullpage-dots" aria-label="页面章节">
