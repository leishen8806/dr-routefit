<script>
  const panels = [...document.querySelectorAll<HTMLElement>('[data-screen]')];
  const dots = [...document.querySelectorAll<HTMLAnchorElement>('.fullpage-dots a')];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducedMotion) {
    panels.forEach((panel) => panel.classList.add('is-visible'));
  } else {
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.28 });
    panels.forEach((panel) => revealObserver.observe(panel));
  }

  const activeObserver = new IntersectionObserver((entries) => {
    const active = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (!active) return;
    const activeIndex = panels.indexOf(active.target as HTMLElement);
    dots.forEach((dot, index) => index === activeIndex ? dot.setAttribute('aria-current', 'step') : dot.removeAttribute('aria-current'));
  }, { threshold: [0.45, 0.7] });
  panels.forEach((panel) => activeObserver.observe(panel));
</script>
