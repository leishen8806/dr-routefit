  <section id="screen-4" class="fullpage-panel panel-shop" data-screen="4" aria-labelledby="screen-4-title">
    <div class="panel-shell panel-shell-reverse">
      <div class="panel-copy" data-motion="copy">
        <p class="panel-index">{panelIndex(3)}</p>
        <h2 id="screen-4-title">{screens[3].titleLines.map((line) => <span class="title-line">{line}</span>)}</h2>
        <p class="panel-lead">{copy.values.items[2].body}</p>
        <ul class="panel-facts"><li>{copy.process.items[2].body}</li></ul>
      </div>
      <div class="panel-scene" data-motion="scene" aria-hidden="true">
