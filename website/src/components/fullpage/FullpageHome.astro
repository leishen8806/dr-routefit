          <g data-motion="vehicle-b" filter="url(#shadow-2)"><path d="m266 425 91-51 79 30-92 53Z" fill="#fff"/><path d="m266 425 78 32v51l-78-31Z" fill="#dbe6eb"/><path d="m344 457 92-53v51l-92 53Z" fill="#13c29b"/><circle cx="296" cy="489" r="18" fill="#071b32"/><circle cx="393" cy="471" r="18" fill="#071b32"/></g>
