        <p class="panel-lead">{copy.values.items[0].body}</p>
        <ul class="panel-facts"><li>{copy.process.items[1].body}</li></ul>
        <details class="panel-disclosure" data-fact="payment">
          <summary>{copy.faq.items[1].question}</summary>
