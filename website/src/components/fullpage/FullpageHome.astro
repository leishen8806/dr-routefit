    <div class="panel-shell">
      <div class="panel-copy" data-motion="copy">
        <p class="panel-index">{panelIndex(4)}</p>
        <h2 id="screen-5-title">{screens[4].titleLines.map((line) => <span class="title-line">{line}</span>)}</h2>
        <p class="panel-lead">{copy.values.items[3].body}</p>
        <ul class="panel-facts"><li>{copy.process.items[3].body}</li><li>{copy.faq.items[3].answer}</li></ul>
