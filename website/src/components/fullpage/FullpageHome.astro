---
import type { Language, SiteCopy } from '../../content/types';

interface Props { lang: Language; copy: SiteCopy }
const { lang, copy } = Astro.props;
const screens = copy.fullpage.screens;
const withLang = (href: string) => href.startsWith('/') ? `/${lang}${href}` : href;
const languages = [{ code: 'km', label: 'ខ្មែរ' }, { code: 'en', label: 'English' }, { code: 'zh', label: '中文' }] as const;
const panelIndex = (index: number) => index === 0 ? '01 / 06' : `0${index + 1} / 06 · ${screens[index].label}`;
---
<header class="fullpage-topbar">
  <a class="topbar-mark" href={`/${lang}/`} aria-label={`DR RouteFit · ${copy.nav.home}`}><img src="/logo.svg" alt="DR RouteFit" /></a>
  <div class="topbar-actions">
    <nav class="topbar-languages" aria-label={copy.nav.language}>
      {languages.map((item) => <a class="language-link" href={`/${item.code}/`} lang={item.code} aria-current={item.code === lang ? 'true' : undefined}>{item.label}</a>)}
    </nav>
    <a class="topbar-contact" href={`/${lang}/contact/`}>{copy.nav.contact}</a>
  </div>
</header>
<div class="fullpage-home" aria-label={copy.fullpage.ariaLabel}>
  <nav class="fullpage-dots" aria-label={copy.fullpage.sectionsLabel}>
    {screens.map((screen, index) => (
      <a href={`#screen-${index + 1}`} aria-label={screen.label} aria-current={index === 0 ? 'step' : undefined}>
        <span aria-hidden="true"></span>
      </a>
    ))}
  </nav>

  <section id="screen-1" class="fullpage-panel panel-dawn" data-screen="1" aria-labelledby="screen-1-title">
    <div class="panel-shell">
      <div class="panel-copy" data-motion="copy">
        <p class="panel-index">{panelIndex(0)}</p>
        <h1 id="screen-1-title">{screens[0].titleLines.map((line) => <span class="title-line">{line}</span>)}</h1>
        <p class="panel-lead">{copy.hero.body}</p>
        <ul class="panel-facts">
          <li>{copy.process.items[0].body}</li>
          <li>{copy.quick[0].body}</li>
        </ul>
        <div class="panel-actions">
          <a class="panel-button" href={`/${lang}/contact/`}>{copy.hero.primary}</a>
          <a class="panel-button panel-button-secondary" href={`/${lang}/drivers/`}>{copy.hero.secondary}</a>
        </div>
      </div>
      <div class="panel-scene" data-motion="scene" aria-hidden="true">
        <svg viewBox="0 0 720 580" role="presentation">
          <defs>
            <linearGradient id="dawn-sky" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#dceff2"/><stop offset="1" stop-color="#fff3d9"/></linearGradient>
            <linearGradient id="dawn-road" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#d8e0e6"/><stop offset="1" stop-color="#b9c6d1"/></linearGradient>
            <filter id="shadow-1" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="16" stdDeviation="12" flood-color="#0b2545" flood-opacity=".17"/></filter>
          </defs>
          <rect width="720" height="580" rx="36" fill="url(#dawn-sky)"/>
          <circle cx="548" cy="114" r="52" fill="#f5a623" opacity=".68"/>
          <path d="M0 370 225 244 720 414 475 580H0Z" fill="#eef3f2"/>
          <path d="m125 580 344-188 182 70-202 118Z" fill="url(#dawn-road)"/>
          <path d="m162 565 317-157" stroke="#fff" stroke-width="5" stroke-dasharray="26 18" opacity=".9"/>
          <g filter="url(#shadow-1)">
            <path d="m58 292 178-99 154 58-179 103Z" fill="#0b2545"/><path d="m58 292 153 60v92L58 385Z" fill="#173a61"/><path d="m211 352 179-101v90L211 444Z" fill="#f7faf9"/>
            <path d="m84 316 96 37v55l-96-37Z" fill="#13c29b" opacity=".88"/><path d="m233 362 56-32v66l-56 33Z" fill="#dbe7ec"/>
          </g>
          <g opacity=".66">
            <path d="m506 238 66-37 61 23-67 39Z" fill="#0b2545"/><path d="m506 238 60 23v66l-60-23Z" fill="#173a61"/><path d="m566 261 67-37v65l-67 38Z" fill="#f8faf9"/>
            <path d="m604 333 48-27 42 16-48 28Z" fill="#13c29b"/><path d="m604 333 42 17v47l-42-17Z" fill="#0f9f82"/>
          </g>
          <g data-motion="truck" filter="url(#shadow-1)">
            <path d="m286 413 105-58 94 35-106 61Z" fill="#f7faf9"/><path d="m286 413 93 38v58l-93-37Z" fill="#dfe8ed"/><path d="m379 451 106-61v58l-106 61Z" fill="#0b2545"/>
