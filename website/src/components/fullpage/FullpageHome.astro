            <circle class="vehicle-wheel" cx="328" cy="507" r="18" fill="#071b32"/><circle class="vehicle-wheel" cx="431" cy="493" r="18" fill="#071b32"/>
          </g>
          <g opacity=".55"><circle cx="102" cy="475" r="24" fill="#13c29b"/><rect x="96" y="475" width="12" height="61" fill="#7b8c77"/><circle cx="671" cy="416" r="20" fill="#13c29b"/><rect x="666" y="416" width="10" height="48" fill="#7b8c77"/></g>
        </svg>
      </div>
    </div>
  </section>

  <section id="screen-2" class="fullpage-panel panel-sand" data-screen="2" aria-labelledby="screen-2-title">
    <span id="services" class="panel-anchor" aria-hidden="true"></span>
    <div class="panel-shell panel-shell-reverse">
      <div class="panel-copy" data-motion="copy">
        <p class="panel-index">{panelIndex(1)}</p>
