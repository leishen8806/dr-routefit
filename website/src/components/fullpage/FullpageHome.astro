          <g data-motion="proof-a" filter="url(#shadow-5)"><path d="m69 173 132-74 111 41-133 77Z" fill="#f8faf9"/><path d="m69 173 110 44v120L69 294Z" fill="#dce6ea"/><path d="m179 217 133-77v119l-133 78Z" fill="#fff"/><circle cx="223" cy="240" r="28" fill="#13c29b"/><path d="m210 240 10 11 20-26" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></g>
          <g data-motion="proof-b" filter="url(#shadow-5)"><path d="m429 361 130-73 110 41-132 76Z" fill="#f8faf9"/><path d="m429 361 108 44v111l-108-42Z" fill="#dce6ea"/><path d="m537 405 132-76v110l-132 77Z" fill="#fff"/><circle cx="581" cy="425" r="28" fill="#13c29b"/><path d="m568 425 10 11 20-26" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></g>
          <g data-motion="proof-c" filter="url(#shadow-5)"><circle cx="134" cy="424" r="56" fill="#f5a623"/><path d="m107 423 20 22 39-50" fill="none" stroke="#fff" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/></g>
