    <div class="panel-shell panel-shell-final">
      <div class="panel-copy panel-copy-final" data-motion="copy">
        <p class="panel-index">{panelIndex(5)}</p>
        <h2 id="screen-6-title">{screens[5].titleLines.map((line) => <span class="title-line">{line}</span>)}</h2>
        <p class="panel-lead">{copy.audiences[1].body}</p>
        <ul class="panel-facts"><li>{copy.audiences[0].body}</li><li>{copy.faq.items[0].answer}</li></ul>
        <div class="entry-grid" aria-label={screens[5].label}>
          <a href={withLang(copy.quick[0].href)}><strong>{copy.quick[0].title}</strong><span>{copy.quick[0].action}</span></a>
          <a href={withLang(copy.quick[1].href)}><strong>{copy.quick[1].title}</strong><span>{copy.quick[1].action}</span></a>
          <a href={`/${lang}/contact/`}><strong>{copy.nav.contact}</strong><span>{copy.audiences[1].action}</span></a>
        </div>
      </div>
      <div class="panel-scene panel-scene-final" data-motion="scene" aria-hidden="true">
