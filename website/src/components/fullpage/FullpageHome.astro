          <rect width="720" height="580" rx="36" fill="url(#evening-sky)"/><circle cx="568" cy="145" r="62" fill="#ffe4a8" opacity=".82"/><path d="M0 398 247 260l473 172v148H0Z" fill="#19314b"/>
          <g opacity=".32"><path d="m35 311 45-25 37 14-45 26Z" fill="#071b32"/><path d="m92 284 51-29 42 16-52 30Z" fill="#071b32"/><path d="m615 310 54-30 45 17-55 32Z" fill="#071b32"/></g>
          <g filter="url(#shadow-6)"><path d="m189 235 203-114 172 64-205 119Z" fill="#071b32"/><path d="m189 235 170 68v143l-170-65Z" fill="#0b2545"/><path d="m359 303 205-118v142L359 446Z" fill="#edf2f1"/><path d="m399 318 108-63v99l-108 63Z" fill="#13c29b" opacity=".72"/></g>
          <g filter="url(#shadow-6)"><path d="m93 435 85-48 75 28-87 51Z" fill="#fff"/><path d="m93 435 73 31v48l-73-29Z" fill="#dbe5e9"/><path d="m166 466 87-51v48l-87 51Z" fill="#13c29b"/><circle cx="120" cy="497" r="17" fill="#071b32"/><circle cx="211" cy="480" r="17" fill="#071b32"/><path d="m272 421 94-53 82 31-96 55Z" fill="#0b2545"/><path d="m272 421 80 33v55l-80-32Z" fill="#173a61"/><path d="m352 454 96-55v54l-96 56Z" fill="#f8faf9"/><circle cx="303" cy="489" r="18" fill="#071b32"/><circle cx="402" cy="470" r="18" fill="#071b32"/><path d="m467 405 99-56 86 32-101 59Z" fill="#f5a623"/><path d="m467 405 84 35v56l-84-33Z" fill="#db8a10"/><path d="m551 440 101-59v56l-101 59Z" fill="#fff1d4"/><circle cx="500" cy="476" r="18" fill="#071b32"/><circle cx="605" cy="456" r="18" fill="#071b32"/></g>
        </svg>
      </div>
    </div>
