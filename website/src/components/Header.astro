---
import { content, languageNames, languages, localizedPath } from '../lib/site';
import type { Language } from '../content/types';

interface Props { lang: Language; pathname: string }
const { lang, pathname } = Astro.props;
const copy = content[lang];
const links = [
  { label: copy.nav.services, href: `/${lang}/#services` },
  { label: copy.nav.pricing, href: `/${lang}/pricing/` },
  { label: copy.nav.drivers, href: `/${lang}/drivers/` },
  { label: copy.nav.track, href: `/${lang}/#track`, disabled: true },
  { label: copy.nav.about, href: `/${lang}/#about` },
  { label: copy.nav.help, href: `/${lang}/#help` }
];
---
<header class="site-header">
  <div class="shell header-row">
    <a class="brand" href={`/${lang}/`} aria-label={`DR RouteFit · ${copy.nav.home}`}><img src="/logo.svg" alt="DR RouteFit" /></a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {links.map(({ label, href, disabled }) => disabled ? <span class="nav-disabled" aria-disabled="true">{label}</span> : <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="desktop-actions">
      <div class="language-switcher" aria-label={copy.nav.language}>
        {languages.map((item) => <a class="language-link" href={localizedPath(item, pathname)} lang={item} aria-current={item === lang ? 'true' : undefined}>{languageNames[item]}</a>)}
      </div>
      <a class="button button-small" href={`/${lang}/contact/`}>{copy.nav.contact}</a>
    </div>
    <details class="mobile-menu">
      <summary aria-label={copy.nav.menu}><span></span><span></span><span></span></summary>
      <div class="mobile-menu-panel">
        <nav aria-label="Primary navigation">
          {links.map(({ label, href, disabled }) => disabled ? <span class="nav-disabled" aria-disabled="true">{label}</span> : <a href={href} aria-current={pathname === href ? 'page' : undefined}>{label}</a>)}
          <a href={`/${lang}/contact/`}>{copy.nav.contact}</a>
        </nav>
        <div class="language-switcher" aria-label={copy.nav.language}>
          {languages.map((item) => <a class="language-link" href={localizedPath(item, pathname)} lang={item} aria-current={item === lang ? 'true' : undefined}>{languageNames[item]}</a>)}
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.language-link').forEach((link) => {
    link.addEventListener('click', () => {
      const language = link.getAttribute('lang');
      try {
        if (language) localStorage.setItem('routefit-language', language);
      } catch {}
    });
  });
</script>
