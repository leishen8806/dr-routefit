{
  "expo": {
    "name": "RouteFit Driver",
    "slug": "routefit-driver",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Allow RouteFit Driver to take delivery evidence photos.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
