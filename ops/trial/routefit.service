[Unit]
Description=DR RouteFit local trial service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=routefit
Group=routefit
EnvironmentFile=/etc/routefit/routefit.env
WorkingDirectory=/opt/dr-routefit/services/routefit
ExecStart=/usr/bin/node main.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/routefit /var/log/routefit

[Install]
WantedBy=multi-user.target
