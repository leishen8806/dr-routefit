[Unit]
Description=DR RouteFit local trial service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=routefit
Group=routefit
EnvironmentFile=/etc/routefit/routefit.env
Environment=ROUTEFIT_SESSION_FILE=/var/lib/routefit/sessions.json
WorkingDirectory=/srv/routefit/services/routefit
# <NODE24_PATH> must be the absolute path to a Node 24 executable; RF-OPS-01 replaces this at deployment.
ExecStart=<NODE24_PATH> main.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=routefit
StateDirectoryMode=0700
LogsDirectory=routefit
ReadWritePaths=/var/lib/routefit /var/log/routefit

[Install]
WantedBy=multi-user.target
