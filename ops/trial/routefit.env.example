# Install as /etc/routefit/routefit.env, owned by root:root, mode 600.
NODE_ENV=development
ROUTEFIT_TRIAL=1
ROUTEFIT_AUTH_MODE=development
ROUTEFIT_DATABASE_URL=<LOCAL_DATABASE_URL_WITH_CREDENTIALS>
# Root-only file created by trial:init; contains the dedicated read-only backup role URL.
ROUTEFIT_BACKUP_ENV_FILE=/root/.config/routefit/backup.env
ROUTEFIT_SESSION_FILE=/var/lib/routefit/sessions.json
ROUTEFIT_PORT=4180
ROUTEFIT_ALLOWED_ORIGIN=http://127.0.0.1:4180
