NODE_ENV=development
ROUTEFIT_AUTH_MODE=development
# Replace only in ignored local environment files. Never use a superuser here.
ROUTEFIT_DATABASE_URL=postgresql://routefit_runtime:REPLACE_LOCALLY@127.0.0.1:5432/routefit_dev
ROUTEFIT_SESSION_FILE=.local/sessions.json
ROUTEFIT_ALLOWED_ORIGIN=http://127.0.0.1:4180
ROUTEFIT_PORT=4180
# Local object-store replacement for synthetic evidence only; never point at a shared or production path.
ROUTEFIT_EVIDENCE_DIRECTORY=.local/evidence
# Explicit local-only OTP sink for recipient-flow development. Do not configure this outside a disposable local environment.
ROUTEFIT_RECIPIENT_CODE_SINK=.local/recipient-codes.jsonl
# Separate administrator connection for migrations, never passed to the HTTP service pool.
ROUTEFIT_MIGRATION_DATABASE_URL=postgresql://routefit_migrator:REPLACE_LOCALLY@127.0.0.1:5432/routefit_dev
# Explicit sandbox-only KESS worker identity. It must be an active STAFF/SERVICE principal in the same local company.
# Run `node scripts/kess-payment-worker.mjs` manually after setting the KESS_* credentials below; never expose these values to a browser.
ROUTEFIT_KESS_WORKER_COMPANY_ID=
ROUTEFIT_KESS_WORKER_PRINCIPAL_ID=
# 32-byte base64 or 64-hex local secret for encrypted account-change drafts. Never commit a real value.
ROUTEFIT_ACCOUNT_CHANGE_KEY=
